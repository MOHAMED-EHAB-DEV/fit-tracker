# FitTracker environment variables
#
# Copy this file to .env (or .env.local) and fill in the values. Never commit
# the real file: .gitignore ignores every .env* file except this one.
# On Vercel, set the same names under Project Settings -> Environment Variables.
#
# For local testing without any of these accounts, run `bun run dev:local`
# instead: it starts an in-memory database and replaces every secret below
# with a local placeholder (see scripts/dev-local.mjs).

# --- Required -----------------------------------------------------------------

# MongoDB connection string (MongoDB Atlas or your own server). Atlas is a
# replica set, so deleting a user runs in one transaction there.
# Example: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/fit-tracker?retryWrites=true&w=majority
MONGODB_URI=

# Signs the session cookie. At least 32 random characters; changing it signs
# everyone out. Generate one with: openssl rand -hex 32
JWT_SECRET=

# Public address of the app, without a trailing slash, e.g. https://fit.example.com
# Used in password reset emails. Required in production unless the app runs on
# Vercel (which provides VERCEL_PROJECT_PRODUCTION_URL automatically): links in
# emails are never built from the request's Host header.
APP_URL=

# --- Optional -----------------------------------------------------------------

# Encrypts users' saved Gemini API keys (AES-256-GCM). Falls back to JWT_SECRET
# when empty. Set it before users save keys: changing it later makes saved keys
# unreadable (users then have to enter them again).
DATA_ENCRYPTION_KEY=

# Google Gemini API key (https://aistudio.google.com/) for the AI coach, photo
# meal estimates, the AI day plan and body-fat estimates. Without it, AI works
# only for users who add their own key in Settings.
GEMINI_API_KEY=

# How much output the AI may produce: full (default), balanced or low.
AI_POWER_MODE=

# Cloudinary (https://cloudinary.com/console): meal photos, private progress
# photos (served only through short-lived signed URLs) and admin exercise images.
# Recommended in the Cloudinary console: Settings -> Security -> enable
# "Strict transformations", so private photos cannot be fetched as derived images.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Supabase Storage: a second-level cache for the public exercise-image proxy
# (/fit-tracker/images/...). Leave empty to cache in memory and /tmp only.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Bucket name (default: fit-tracker-images)
SUPABASE_STORAGE_BUCKET=

# Extra image hosts the exercise-image proxy may fetch from, comma separated,
# exact host names only (res.cloudinary.com and raw.githubusercontent.com are
# always allowed). Example: images.example.com
IMAGE_PROXY_ALLOWED_HOSTS=

# Email (https://resend.com) for password reset links. Without both values no
# email is sent; an admin can then create a one-time reset link on the user's
# page in the admin panel.
RESEND_API_KEY=
# Sender, from a domain verified in Resend, e.g. FitTracker <no-reply@example.com>
EMAIL_FROM=
