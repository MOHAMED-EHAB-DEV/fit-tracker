<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <!-- Frosted glass translucent dark gradient -->
    <gradient
        android:angle="135"
        android:startColor="#E616161B"
        android:centerColor="#D9111114"
        android:endColor="#E60A0A0D"
        android:type="linear" />
    
    <!-- Subtle frosted rim light border -->
    <stroke
        android:width="1.2dp"
        android:color="#2EFFFFFF" />
        
    <corners android:radius="20dp" />
</shape>
