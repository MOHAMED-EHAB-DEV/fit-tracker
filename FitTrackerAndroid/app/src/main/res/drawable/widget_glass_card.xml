<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <!-- Frosted glass translucent dark gradient -->
    <gradient
        android:angle="135"
        android:startColor="#E6141619"
        android:centerColor="#D9141619"
        android:endColor="#E60C0D0F"
        android:type="linear" />
    
    <!-- Subtle frosted rim light border -->
    <stroke
        android:width="1.2dp"
        android:color="#2EFFFFFF" />
        
    <corners android:radius="20dp" />
</shape>
